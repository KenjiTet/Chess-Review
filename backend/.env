# ── Engine ──────────────────────────────────────────────────────────────────
STOCKFISH_PATH=C:\Users\Kenji\stockfish\stockfish-windows-x86-64-avx2.exe

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=Kenji

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in local dev: emails become no-ops and the
# confirmation/reset token is logged to the console instead of sent.
RESEND_API_KEY=re_bd4oQZrm_LVYidC5mH67i7LbbMBWBXd8C
EMAIL_FROM=BlunderDrill <noreply@blunderdrill.com>
# Base URL used to build confirmation / reset links inside emails.
FRONTEND_URL=http://localhost:5173

# ── Google sign-in ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0

# ── Background analysis queue ───────────────────────────────────────────────
ANALYSIS_QUEUE_ENABLED=false
ANALYSIS_CONCURRENCY=2
BACKFILL_TARGET=0
GUEST_BACKFILL_TARGET=0
POLL_INTERVAL=60
POLL_FETCH=20

# ── Blunder of the day ──────────────────────────────────────────────────────
# Daily background job that finds a fresh blunder from a top Grandmaster's blitz
# games and serves it as an interactive puzzle. See services/blunder_of_day.py.
BLUNDER_OF_DAY_ENABLED=true
# How many of the platform's best blitz GMs form the pool to draw from.
BLUNDER_OF_DAY_PLAYER_COUNT=10
# Minimum centipawn loss for a move to qualify as a blunder (matches CANONICAL_THRESHOLD).
BLUNDER_OF_DAY_THRESHOLD=300
# Hard cap on games analysed per day across all GMs — bounds the daily CPU cost.
BLUNDER_OF_DAY_MAX_GAMES=12
# How many recent blitz games to consider per GM before moving to the next one.
BLUNDER_OF_DAY_GAMES_PER_PLAYER=6
# Seconds between worker wake-ups; each tick no-ops until the calendar day rolls over.
BLUNDER_OF_DAY_POLL_INTERVAL=3600

# ── Storage ─────────────────────────────────────────────────────────────────
DATABASE_PATH=cache/app.db

# ── Server ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
FRONTEND_DIST=
